        "Sudden severe breathlessness or chest pain",
        "Sudden vision loss",
        "New weakness, seizures, or severe headache with sarcoid history"
      ],
      "seeDoctorIf": [
        "Persistent cough with fatigue/weight loss",
        "Unexplained lumps or eye symptoms"
      ],
      "doNot": [
        "Do not invent corticosteroid regimens"
      ]
    },
