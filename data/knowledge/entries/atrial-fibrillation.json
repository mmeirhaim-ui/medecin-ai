  "guidance": {
    "en": {
      "summary": "AF is an irregular often rapid heart rhythm that raises stroke risk. NHS: new AF needs medical assessment; anticoagulants/rate control are clinician-prescribed — never invent doses. Emergency: chest pain, severe breathlessness, fainting, stroke symptoms (FAST), or very fast pulse with collapse. See red-flags-cardio/stroke entries.",
      "emergencyIf": [
        "Chest pain or severe breathlessness",
        "Fainting or near-fainting",
        "Stroke symptoms (face/arm/speech)",
        "Collapse with very fast pulse"
      ],
      "seeDoctorIf": [
        "New irregular heartbeat or palpitations",
        "Known AF with worsening symptoms"
      ],
      "doNot": [
        "Do not invent anticoagulant or antiarrhythmic doses",
        "Do not ignore stroke warning signs"
      ]
    },
    "fr": {
      "summary": "FA: rythme irrégulier, risque d'AVC. Urgences si douleur thoracique, dyspnée, malaise, signes d'AVC. Pas de posologies inventées.",
      "emergencyIf": [
        "Douleur thoracique / dyspnée sévère",
        "Syncope",
        "Signes d'AVC"
      ],
      "seeDoctorIf": [
        "Palpitations / rythme irrégulier nouveau"
      ],
      "doNot": [
        "Pas d'anticoagulants inventés"
      ]
    },
    "he": {
      "summary": "פרפור פרוזדורים: דופק לא סדיר, סיכון לשבץ. חירום בכאב חזה, קוצר נשימה, התעלפות, סימני שבץ. אין מינונים מומצאים.",
