    "en": {
      "summary": "Cradle cap is common and usually harmless greasy yellow scales on a baby's scalp. NHS: gentle washing; soften scales with baby oil if advised; do not pick aggressively. See a GP/pharmacist if inflamed, spreading, or baby unwell.",
      "seeDoctorIf": [
        "Scalp looks infected (red, weeping, spreading)",
        "Baby seems unwell",
        "Not improving with gentle care"
      ],
      "selfCare": [
        "Wash hair regularly with mild baby shampoo; soften scales gently; do not scratch off hard"
      ],
      "doNot": [
        "Do not pick crusts forcefully",
        "Do not invent steroid scalp regimens for infants"
      ]
    },
