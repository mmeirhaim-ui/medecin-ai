        "Suicidal plans or intent",
        "Psychosis with risk of harm",
        "Mania with extreme risk-taking or no sleep for days with collapse risk"
      ],
      "seeDoctorIf": [
        "Mood swings disrupting life",
        "Known bipolar with emerging episode"
      ],
      "doNot": [
        "Do not invent lithium/antipsychotic doses",
        "Do not leave someone alone in acute crisis"
      ]
    },
