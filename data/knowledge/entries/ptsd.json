  "guidance": {
    "en": {
      "summary": "PTSD can follow trauma with flashbacks, nightmares, hyperarousal and avoidance. NHS: trauma-focused therapies; medicines only if clinician-prescribed — never invent doses. Emergency: suicidal crisis, harm to others, or acute dissociation with inability to stay safe.",
      "emergencyIf": [
        "Suicidal plans",
        "Immediate risk of harm to self/others",
        "Unable to stay safe during acute flashbacks"
      ],
      "seeDoctorIf": [
        "Symptoms lasting weeks after trauma",
        "Avoidance and nightmares disrupting life"
      ],
      "doNot": [
        "Do not invent benzodiazepine or antidepressant regimens",
        "Do not force detailed trauma retelling in casual chat"
      ]
    },
    "fr": {
      "summary": "TSPT: flashbacks, cauchemars. Thérapies; pas de posologies inventées. Urgences si crise suicidaire.",
      "emergencyIf": [
        "Idées suicidaires avec plan",
        "Risque immédiat de danger"
      ],
      "seeDoctorIf": [
        "Symptômes prolongés après traumatisme"
      ],
      "doNot": [
        "Pas de posologies inventées"
      ]
    },
    "he": {
      "summary": "PTSD: פלאשבקים, סיוטים. טיפולים; אין מינונים מומצאים. חירום במשבר אובדני.",
      "emergencyIf": [
        "תוכניות אובדניות",
        "סיכון מיידי לפגיעה"
