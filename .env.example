# Google Gemini API key (optional — without it, mock mode is used)
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Shared HMAC secret for short-lived consult tickets (multi-instance safe).
# If unset, production derives a stable secret from DATABASE_URL.
# Do not rely on GEMINI_API_KEY alone for signing — cold instances without the
# key would mint/verify with different secrets (« Jeton invalide. »).
# CONSULT_TOKEN_SECRET=

# Comma-separated trusted browser origins/hosts for /api/consult (in addition to
# request Host, X-Forwarded-Host, VERCEL_URL, localhost, and *.apps.grok.bot)
# ALLOWED_ORIGINS=https://doctor-ai.apps.grok.bot,https://medecin-ai.apps.grok.bot,http://localhost:3000

# Optional model override (default: gemini-3.5-flash-lite; falls back to flash)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Search grounding (slower; off by default)
# GEMINI_ENABLE_GROUNDING=1
