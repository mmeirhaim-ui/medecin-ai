# Google Gemini API key (optional — without it, mock mode is used)
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Optional HMAC secret for short-lived consult tickets (falls back to GEMINI_API_KEY)
# CONSULT_TOKEN_SECRET=

# Comma-separated trusted browser origins/hosts for /api/consult (in addition to
# request Host, X-Forwarded-Host, VERCEL_URL, localhost, and *.apps.grok.bot)
# ALLOWED_ORIGINS=https://medecin-ai.apps.grok.bot,http://localhost:3000

# Optional model override (default: gemini-3.6-flash; gemini-2.0-flash shut down 2026-06-01)
# GEMINI_MODEL=gemini-3.6-flash
