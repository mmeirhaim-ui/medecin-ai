    "en": {
      "summary": "OCD involves unwanted intrusive thoughts and repetitive rituals. NHS: talking therapies (e.g. CBT/ERP) and sometimes medicines — never invent SSRI doses. Emergency: suicidal crisis or inability to function with severe self-neglect — crisis pathways.",
      "emergencyIf": [
        "Suicidal thoughts/plans",
        "Severe self-neglect with medical risk"
      ],
      "seeDoctorIf": [
        "Rituals or intrusive thoughts consuming hours daily",
        "Avoidance disrupting work/relationships"
      ],
      "doNot": [
        "Do not invent SSRI or antipsychotic doses",
        "Do not force rituals as advice"
      ]
    },
    "fr": {
      "summary": "TOC: pensées/compulsions. Thérapies; pas de posologies inventées. Urgences si crise suicidaire.",
