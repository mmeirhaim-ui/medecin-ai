  "guidance": {
    "en": {
      "summary": "Hot flushes, night sweats, mood and sleep changes are common around menopause. Any vaginal bleeding after menopause needs GP assessment (NHS) — do not ignore. HRT and other treatments are clinician decisions; this pack does not prescribe.",
      "emergencyIf": [
        "Very heavy bleeding with dizziness or fainting"
      ],
      "seeDoctorIf": [
        "Any bleeding after menopause",
        "Symptoms disrupting life (flushes, sleep, mood, vaginal dryness)",
        "Unsure if bleeding is postmenopausal"
      ],
      "selfCare": [
        "Layered clothing, cool bedroom, limit alcohol/spicy triggers if they worsen flushes",
        "Discuss options with a clinician rather than self-medicating hormones"
      ],
      "doNot": [
        "Do not ignore postmenopausal bleeding",
        "Do not start hormone therapy without clinical advice"
      ]
    },
    "fr": {
      "summary": "Bouffées, sueurs nocturnes, troubles de l'humeur/sommeil sont fréquents. Tout saignement après la ménopause nécessite un avis médical. Pas d'hormonothérapie inventée.",
      "emergencyIf": [
        "Saignement très abondant avec malaise"
      ],
      "seeDoctorIf": [
        "Tout saignement post-ménopausique",
        "Symptômes qui perturbent la vie"
      ],
      "selfCare": [
        "Vêtements en couches, chambre fraîche"
      ],
      "doNot": [
        "Ne pas ignorer un saignement post-ménopausique"
      ]
    },
    "he": {
