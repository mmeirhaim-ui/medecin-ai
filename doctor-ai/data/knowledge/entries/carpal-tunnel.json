  "guidance": {
    "en": {
      "summary": "Carpal tunnel causes tingling/numbness in thumb, index, middle fingers, often worse at night. NHS: wrist splints, activity modification; GP for persistent symptoms. Surgery/steroid injection are clinician decisions — no invented injection doses. Urgent review for sudden severe weakness or progressive hand weakness.",
      "seeDoctorIf": [
        "Persistent night tingling/numbness",
        "Dropping objects / weakness",
        "Symptoms not helped by splints"
      ],
      "selfCare": [
        "Night wrist splint if advised; avoid repetitive strain; short breaks"
      ],
      "doNot": [
        "Do not invent steroid injection regimens",
        "Do not ignore progressive weakness"
      ]
    },
    "fr": {
      "summary": "Le canal carpien engourdit pouce/index/médius, surtout la nuit. Attelle ; médecin si persistant. Pas d'injections inventées.",
      "seeDoctorIf": [
        "Fourmillements nocturnes persistants",
        "Faiblesse / objets qui tombent"
      ],
      "selfCare": [
        "Attelle nocturne si conseillée ; pauses"
      ],
      "doNot": [
        "Pas d'injections de corticoïdes inventées"
      ]
    },
    "he": {
      "summary": "תעלת שורש: נימול באגודל/אצבע/אמה, לרוב בלילה. סד; רופא אם נמשך. אין זריקות מומצאות.",
      "seeDoctorIf": [
        "נימול לילי מתמשך",
        "חולשה / נפילת חפצים"
      ],
      "selfCare": [
        "סד לילה לפי ייעוץ; הפסקות"
