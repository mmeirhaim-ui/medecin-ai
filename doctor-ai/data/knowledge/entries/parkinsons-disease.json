    "en": {
      "summary": "Parkinson's can cause tremor, stiffness, slowness, and gait changes. NHS: GP/neurology for diagnosis and treatment. Medicines timing matters — never invent levodopa regimens. Falls and swallowing problems need clinical review; emergency for injury after falls or choking.",
      "emergencyIf": [
        "Choking / unable to breathe",
        "Serious injury after a fall"
      ],
      "seeDoctorIf": [
        "New tremor, stiffness, or slowed movement",
        "Known Parkinson's with falls, swallowing difficulty, or medication wearing-off"
      ],
      "doNot": [
        "Do not invent levodopa/agonist regimens",
        "Do not stop Parkinson's medicines abruptly"
      ]
    },
