  "guidance": {
    "en": {
      "summary": "Myasthenia causes fatigable weakness (eyes, face, limbs, breathing). NHS: specialist pathways; crisis with breathing/swallowing failure is an emergency. Never invent anticholinesterase or steroid doses.",
      "emergencyIf": [
        "Difficulty breathing or speaking",
        "Cannot swallow saliva / choking on fluids",
        "Rapidly worsening weakness"
      ],
      "seeDoctorIf": [
        "Drooping eyelid or double vision that worsens with use",
        "Fatigable limb weakness"
      ],
      "doNot": [
        "Do not invent pyridostigmine or steroid doses",
        "Do not delay care for breathing/swallowing trouble"
      ]
    },
    "fr": {
      "summary": "Myasthénie: faiblesse fatigable. Urgence si dyspnée ou fausses routes. Pas de posologies inventées.",
